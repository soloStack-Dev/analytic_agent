# ============================================================
# AI Data Analyst - environment configuration
# Copy .env.example to .env and fill in your values.
# .env is git-ignored - never commit real keys.
# ============================================================

# --- LLM provider ---
# Supported: openai | ollama | groq | openrouter | deepseek
# Any provider exposing an OpenAI-compatible /v1/chat/completions API works.
# If left empty, it is inferred: "openrouter" when the OPEN_ROUTER_* keys
# below are set, otherwise "openai".
LLM_PROVIDER=

# API key for your provider. Leave empty to use the built-in
# rule-based fallback planner (works offline for development).
LLM_API_KEY=

# Model name for your provider, e.g.:
#   openai:     gpt-4o-mini
#   groq:       llama-3.3-70b-versatile
#   deepseek:   deepseek-chat
#   ollama:     llama3.2  (run locally, no key needed)
#   openrouter: nex-agi/nex-n2.5-mini:free
LLM_MODEL=

# Optional: override the API base URL. Defaults are inferred from provider.
# LLM_BASE_URL=https://your-proxy.example.com/v1
LLM_BASE_URL=

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60

# --- OpenRouter (alternative to the generic LLM_* keys above) ---
# If OPEN_ROUTER_API_KEY / OPEN_ROUTER_MODEL are set, the app uses OpenRouter
# automatically (provider = openrouter, base URL = openrouter.ai/api/v1).
# The generic LLM_* vars, when set, take priority over these.
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_MODEL=

# --- Application ---
# Max upload size in megabytes
MAX_UPLOAD_MB=10